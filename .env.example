# Clé API Anthropic (console.anthropic.com) pour traduire les stratégies écrites en français.
# Sans clé, le constructeur manuel et les modèles fonctionnent.
ANTHROPIC_API_KEY=

# Données Binance. Le miroir public répond aussi là où api.binance.com est bloqué.
# BINANCE_API_URL=https://data-api.binance.vision
# NEXT_PUBLIC_BINANCE_WS_URL=wss://data-stream.binance.vision

# Forex, or (XAUUSD) et Nasdaq 100 (NAS100) : clé Twelve Data (twelvedata.com > compte > API Keys).
# Sans clé, seules les cryptos marchent. Le plan gratuit : 8 requêtes par minute, 800 par jour.
TWELVEDATA_API_KEY=
# TWELVEDATA_PER_MINUTE=8

# Nasdaq 100 future (NAS100 = NQ continu, CME) : clé Databento (databento.com > API Keys).
# Facturé au volume téléchargé ; le cache partagé ne télécharge chaque mois qu'une fois.
DATABENTO_API_KEY=

# Postgres : cache des bougies, comptes, stratégies, backtests (Render le fournit). En local : docker compose up -d
DATABASE_URL=postgres://postgres:postgres@localhost:5432/backtest

# Connexion
BETTER_AUTH_SECRET=change-moi-avec-une-longue-chaine-aleatoire
BETTER_AUTH_URL=http://localhost:3000
# E-mails de connexion (resend.com). Sans clé : connexion par mot de passe seulement, adresses non confirmées ;
# en local (next dev), le lien de connexion s'affiche dans le terminal.
RESEND_API_KEY=
EMAIL_FROM="Backtest Lab <connexion@ton-domaine.fr>"
# Connexion Google (console.cloud.google.com > Identifiants > ID client OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Administrateurs (offre Pro sans payer, page /admin), séparés par des virgules.
# Par e-mail : seulement une fois l'adresse confirmée, donc avec RESEND_API_KEY.
ADMIN_EMAILS=
# Par identifiant de compte (affiché sur /compte) : marche sans e-mail confirmé.
ADMIN_USER_IDS=

# Traductions par l'IA par jour pour tout le site (200 par défaut) : plafonne la facture Anthropic.
# AI_DAILY_CAP=200
